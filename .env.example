# Copy to .env.local for local development.
# On Vercel, set the same variables in Project Settings → Environment Variables.
#
# Both are optional: without them the app falls back to a generated sample city.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Seoul open data key for the real-time city data (실시간 도시데이터). Server-side only.
# Do not prefix with NEXT_PUBLIC_, so it is never sent to the browser.
SEOUL_OPEN_API_KEY=서울열린데이터광장_인증키
